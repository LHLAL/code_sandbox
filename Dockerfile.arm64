# 使用支持 ARM64 的 Ubuntu 22.04 镜像
FROM arm64v8/ubuntu:22.04

# 避免交互式提示
ENV DEBIAN_FRONTEND=noninteractive

# 替换为华为云镜像源以加速（麒麟 V10 常用）
RUN sed -i 's@http://ports.ubuntu.com/@http://mirrors.huaweicloud.com/@g' /etc/apt/sources.list

# 安装基础依赖
RUN apt-get update && apt-get install -y \
    software-properties-common \
    curl \
    zip \
    python3-pip \
    python3-dev

# 麒麟 V10 / ARM64 下 PPA 可能不完全支持所有版本，通常直接安装系统自带版本
# 如果需要特定版本，建议通过源码编译或使用 conda 环境
# 这里安装系统默认的 Python3 (通常是 3.10)
RUN apt-get install -y python3.10 python3.10-dev

# 设置工作目录
WORKDIR /app

# 安装项目所需的 Python 依赖
RUN pip3 install --no-cache-dir -i https://mirrors.huaweicloud.com/repository/pypi/simple fastapi uvicorn PyYAML pydantic slowapi pytest httpx

# 复制项目文件
COPY . .

# 创建配置目录
RUN mkdir -p /app/config

# 环境变量
ENV SANDBOX_CONFIG_PATH=/app/config/config.yaml

# 暴露端口
EXPOSE 8000

# 启动命令
CMD ["python3", "main.py"]
